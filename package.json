{
  "name": "backend",
  "version": "1.0.0",
  "description": "Scalable Node.js + Express + PostgreSQL + TypeORM Backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --passWithNoTests",
    "typeorm": "typeorm -d src/config/database.js",
    "migration:generate": "typeorm migration:generate -d src/config/database.js",
    "migration:create": "typeorm migration:create",
    "migration:run": "typeorm migration:run -d src/config/database.js",
    "migration:revert": "typeorm migration:revert -d src/config/database.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
