# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SYNCHRONIZE=true

# Authentication Configuration
JWT_SECRET=super_secret_jwt_key_dev_mode_12345
JWT_EXPIRES_IN=7d

# Encryption Key for sensitive OAuth tokens (32 bytes recommended)
ENCRYPTION_KEY=super_secure_encryption_key_32_bytes_long_123

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/github/callback
GITHUB_API_URL=https://api.github.com

# GitLab Integration
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://localhost:5000/api/v1/gitlab/callback
GITLAB_API_URL=https://gitlab.com/api/v4

# Webhook Base Configuration
WEBHOOK_BASE_URL=http://localhost:5000/api/v1/webhooks
WEBHOOK_SECRET=super_secret_webhook_verification_token
